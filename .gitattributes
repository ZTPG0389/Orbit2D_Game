# Unity YAML files — keep LF to avoid diff noise
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.physicsMaterial2D text eol=lf
*.inputactions text eol=lf

# C# source
*.cs text eol=lf

# Binary assets — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.fbx binary
*.pdf binary
